---
import { Image } from "astro:assets";
import imapLogo from "../assets/imgs/IMAP.png";
---

<section id="experiencia" class="animate-on-scroll">
    <div class="experiencia-content">
        <h2 class="section-title">Experiencia Laboral</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="card">
                    <span class="date">Noviembre 2025 — Actualidad</span>
                    <h3>Desarrollador Web - Prácticas</h3>
                    <span class="company">
                        <Image
                            src={imapLogo}
                            alt="IMAP Logo"
                            width={40}
                            height={40}
                        />
                        IMAP Internet Marketing S.L
                    </span>
                    <p>
                        Desarrollo de aplicaciones web utilizando diferentes
                        tecnologías, como PHP, WordPress, MySQL, HTML, CSS y
                        JavaScript.
                        <br />
                        También mantenimiento de servidores y páginas web de clientes.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
